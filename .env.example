# ──────────────────────────────────────────────────────────
# Branding / codename
# Change these two values to rebrand the entire platform.
# No other place should hardcode the product name.
# ──────────────────────────────────────────────────────────
APP_NAME=Fitness Court
APP_DOMAIN=fitnesscourt.local

# ──────────────────────────────────────────────────────────
# Runtime
# ──────────────────────────────────────────────────────────
ENV=dev                          # dev | staging | prod
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000

# ──────────────────────────────────────────────────────────
# Security
# Generate with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────
SECRET_KEY=change_me_use_openssl_rand_hex_32
QR_SIGNING_KEY=change_me_separate_key_for_qr_tokens
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
QR_TOKEN_TTL_SECONDS=30

# ──────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────
POSTGRES_USER=fitnesscourt
POSTGRES_PASSWORD=fitnesscourt_dev
POSTGRES_DB=fitnesscourt
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fitnesscourt:fitnesscourt_dev@db:5432/fitnesscourt

# ──────────────────────────────────────────────────────────
# Redis (cache + Celery broker + QR single-use store)
# ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ──────────────────────────────────────────────────────────
# Telegram bot
# Get token from @BotFather. For local dev, expose webhook via
# ngrok / cloudflared and set TELEGRAM_WEBHOOK_URL to the tunnel URL.
# ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me_random_string
TELEGRAM_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────
# Email (transactional only in v1.0)
# Provider: Resend (recommended). Leave empty to log emails to stdout in dev.
# ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@fitnesscourt.local

# ──────────────────────────────────────────────────────────
# Sentry (optional in dev, required in prod)
# ──────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ──────────────────────────────────────────────────────────
# Frontend → backend
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Fitness Court
